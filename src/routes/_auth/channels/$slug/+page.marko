import styles from "./style.module.css";

<const/{
  userId,
  editId,
  me,
  channelList,
  activeChannel,
  messages,
  onlineMembers,
  offlineMembers,
}=$global.data>
<const/{ slug }=$global.params>

<id/navId>
<id/asideId>

// Three columns split by grey lines that run up behind the header's
// rainbow: nav | main | aside, the header's cells lined up over them. On
// narrower screens the aside, then the nav, become popovers: full-height
// drawers over the page, opened by buttons that join the header.
<div class=styles.app>
  <ui-header class=styles.header>
    <div class=styles.brand>
      <app-logo/>
    </div>
    // In the narrowest layouts the channel's name moves into the button that
    // opens the channels drawer; the heading stays for screen readers.
    <ui-button class=styles.navToggle type="button" popovertarget=navId>
      <icon-channels label="Channels"/>
      <span class=styles.navName>${slug}</span>
    </ui-button>
    <h1 class=styles.title>#${slug}</h1>
    <div class=styles.account>
      // The count online after the icon: up to 3 digits, then 1K+. Screen
      // readers get the full number.
      <ui-button
        class=styles.asideToggle
        type="button"
        title="Members"
        popovertarget=asideId
      >
        <icon-members label="Members"/>
        <try>
          <@placeholder/>
          <await|members|=onlineMembers>
            <span class=styles.count aria-hidden="true">
              ${members.length >= 1000 ? "1K+" : members.length}
            </span>
            <span class="visually-hidden">${members.length} online</span>
          </await>
        </try>
      </ui-button>
      <app-status-menu user=me/>
    </div>
  </ui-header>
  <nav id=navId class=styles.nav aria-label="Channels" popover>
    <ui-scroll-area class=styles.scroll contentClass=styles.panel>
      <ui-section heading="Channels">
        <@action>
          <app-channel-form/>
        </@action>
        <app-channel-list channels=channelList activeSlug=slug/>
      </ui-section>
    </ui-scroll-area>
  </nav>
  <main class=styles.main>
    <try>
      <@placeholder>
        <p>Loading...</p>
      </@placeholder>
      <await|channel|=activeChannel>
        <if=channel>
          <app-message-list
            slug=slug
            page=messages
            viewerId=userId
            editId=editId
            url=$global.url
          />
          <app-message-composer channelSlug=channel.slug/>
        </if>
        <else>
          <ui-empty heading="Whoops" symbol="#">
            Looks like this channel doesn't exist.
          </ui-empty>
        </else>
      </await>
    </try>
  </main>
  <aside id=asideId class=styles.aside aria-label="Members" popover>
    <ui-scroll-area class=styles.scroll contentClass=styles.panel>
      <app-member-list title="Online" members=onlineMembers/>
      <app-member-list title="Offline" members=offlineMembers muted/>
    </ui-scroll-area>
  </aside>
</div>
