import styles from "./style.module.css";

<const/{
  userId,
  editId,
  me,
  channelList,
  activeChannel,
  messages,
  onlineMembers,
  offlineMembers,
}=$global.data>
<const/{ slug }=$global.params>

<id/navId>
<id/asideId>

// Three columns ruled from the header down: nav | main | aside. The header's
// cells line up with the columns below them. On narrower screens the aside,
// then the nav, become popovers: full-height drawers over the page, opened by
// buttons that join the account in the header.
<div class=styles.app>
  <header class=styles.header>
    <div class=styles.brand>
      <div class=styles.logo>
        <ui-logo/>
      </div>
      // In the narrowest layout the brand cell dissolves: this goes to the far
      // left, and the logo's mark beside the title, centred on the screen.
      <ui-button
        class=styles.navToggle
        type="button"
        icon="channels"
        size="large"
        label="Channels"
        popovertarget=navId
      />
    </div>
    <h1 class=styles.title>#${slug}</h1>
    <div class=styles.account>
      <ui-button
        class=styles.asideToggle
        type="button"
        icon="members"
        size="large"
        label="Members"
        popovertarget=asideId
      />
      <app-status-menu user=me/>
    </div>
  </header>
  <nav id=navId class=styles.nav aria-label="Channels" popover>
    <ui-scroll-area class=styles.scroll contentClass=styles.panel>
      <ui-section heading="Channels">
        <@action>
          <app-channel-form/>
        </@action>
        <app-channel-list channels=channelList activeSlug=slug/>
      </ui-section>
    </ui-scroll-area>
  </nav>
  <main class=styles.main>
    <try>
      <@placeholder>
        <p>Loading...</p>
      </@placeholder>
      <await|channel|=activeChannel>
        <if=channel>
          <app-message-list
            slug=slug
            page=messages
            viewerId=userId
            editId=editId
            url=$global.url
          />
          <app-message-composer channelSlug=channel.slug/>
        </if>
        <else>
          <ui-empty heading="Whoops">
            Looks like this channel doesn't exist.
          </ui-empty>
        </else>
      </await>
    </try>
  </main>
  <aside id=asideId class=styles.aside aria-label="Members" popover>
    <ui-scroll-area class=styles.scroll contentClass=styles.panel>
      <app-member-list title="Online" members=onlineMembers/>
      <app-member-list title="Offline" members=offlineMembers muted/>
    </ui-scroll-area>
  </aside>
</div>
