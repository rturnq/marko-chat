import exo2 from "@fontsource-variable/exo-2/files/exo-2-latin-wght-normal.woff2?url";
import jetbrainsMono from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "./style.module.css";

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#06070d">
    <title>Marko Chat</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="./favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="./apple-touch-icon.png">
    <link rel="preload" href=exo2 as="font" type="font/woff2" crossorigin>
    <link rel="preload" href=jetbrainsMono as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="./stars.svg" as="image" type="image/svg+xml">
    <link rel="preload" href="../tags/ui-header/rainbow.svg" as="image" type="image/svg+xml">
  </head>
  <body>
    // Gradients the status icons fill with: a lit green dot, a yellow-orange moon.
    <svg class="visually-hidden" aria-hidden="true">
      <defs>
        <radialGradient id="status-active" cx="0.35" cy="0.35" r="0.75">
          <stop offset="0" stop-color="#e2ffd8"/>
          <stop offset="0.45" stop-color="#7ced64"/>
          <stop offset="1" stop-color="#00b068"/>
        </radialGradient>
        <linearGradient id="status-away" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffe45c"/>
          <stop offset="0.55" stop-color="#ffd100"/>
          <stop offset="1" stop-color="#fc5c00"/>
        </linearGradient>
      </defs>
    </svg>
    <${input.content}/>
  </body>
</html>
