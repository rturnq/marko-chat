import styles from "./style.module.css";

export type IconName =
  | "add"
  | "add-reaction"
  | "more"
  | "send"
  | "edit"
  | "delete"
  | "log-out"
  | "error"
  | "chevron-down"
  | "chevron-up"
  | "channels"
  | "members"
  | "cancel"
  | "save"
  | "link";

export interface Input {
  name: IconName;
  /** Names the icon for screen readers; unlabelled icons are hidden. */
  label?: string;
}


<if=input.name === "chevron-down" || input.name === "chevron-up">
  // Chevrons are drawn smaller, with a 2px line.
  <svg
    class=styles.icon
    width="12"
    height="12"
    viewBox="0 0 12 12"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    role=input.label ? "img" : undefined
    aria-label=input.label
    aria-hidden=!input.label && "true"
  >
    <if=input.name === "chevron-up">
      <path d="M2.5 7.5 6 4l3.5 3.5"/>
    </if>
    <else>
      <path d="M2.5 4.5 6 8l3.5-3.5"/>
    </else>
  </svg>
</if>
<else>
  // Everything else is 16px in a 24 box, so a 3px stroke renders at 2px.
  <svg
    class=styles.icon
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    role=input.label ? "img" : undefined
    aria-label=input.label
    aria-hidden=!input.label && "true"
  >
    <if=input.name === "add">
      <path d="M12 5v14M5 12h14"/>
    </if>
    <else if=input.name === "add-reaction">
      <circle cx="10.5" cy="13.5" r="7.5"/>
      <path d="M7.8 15.6c.7.9 1.6 1.4 2.7 1.4s2-.5 2.7-1.4"/>
      <path d="M8 11.2h.01M13 11.2h.01"/>
      <path d="M19.5 2v6M16.5 5h6"/>
    </else>
    <else if=input.name === "more">
      <circle cx="5" cy="12" r="2.2" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>
      <circle cx="19" cy="12" r="2.2" fill="currentColor" stroke="none"/>
    </else>
    <else if=input.name === "send">
      <path d="M21 3 3 10.5l7.5 3L21 3z"/>
      <path d="M21 3l-7.5 18-3-7.5"/>
    </else>
    <else if=input.name === "edit">
      <path d="M4 20h4L19 9l-4-4L4 16z"/>
      <path d="M13 7l4 4"/>
    </else>
    <else if=input.name === "delete">
      <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>
    </else>
    <else if=input.name === "log-out">
      <path d="M12 3.5H6A2.5 2.5 0 0 0 3.5 6v12A2.5 2.5 0 0 0 6 20.5h6"/>
      <path d="M9.5 12h11M16.5 8l4 4-4 4"/>
    </else>
    <else if=input.name === "channels">
      <path d="M9.5 3.5 7.5 20.5M16.5 3.5l-2 17M4 8.5h16.5M3.5 15.5h16.5"/>
    </else>
    <else if=input.name === "members">
      <circle cx="9" cy="8.5" r="3.5"/>
      <path d="M3 20.5a6 6 0 0 1 12 0"/>
      <path d="M16 5a3.5 3.5 0 0 1 0 7M18.5 14.5a6 6 0 0 1 2.5 6"/>
    </else>
    <else if=input.name === "link">
      <path d="M11 13a4 4 0 0 0 6 .4l2.6-2.6a4 4 0 0 0-5.7-5.7L12.6 6.4"/>
      <path d="M13 11a4 4 0 0 0-6-.4l-2.6 2.6a4 4 0 0 0 5.7 5.7l1.3-1.3"/>
    </else>
    <else if=input.name === "cancel">
      <path d="M6 6l12 12M18 6 6 18"/>
    </else>
    <else if=input.name === "save">
      <path d="M4.5 12.5l5 5L19.5 7"/>
    </else>
    <else if=input.name === "error">
      // An alert dot: berry fill, white "!".
      <circle cx="12" cy="12" r="9.5" style="fill: var(--berry); stroke: var(--ink)"/>
      <path d="M12 7.5v5.5" style="stroke: var(--white)"/>
      <circle cx="12" cy="16.8" r="1.6" style="fill: var(--white)" stroke="none"/>
    </else>
  </svg>
</else>
