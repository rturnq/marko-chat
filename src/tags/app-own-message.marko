import type { Message } from "../server/db";

export interface Input {
  message: Message;
  editing: boolean;
  /** The page to show once the message is edited or deleted. */
  returnUrl: string;
  /** This page with this message in edit mode. */
  editHref: string;
}

<const/{ message }=input>
<const/action=Run.href("/messages/$id", { params: { id: message.id } })>
<const/error=(
  input.editing ? $global.session?.get("POST:/messages/$id") : undefined
)>
<id/editFormId>

// The viewer is the message's author.
<app-message message=message viewerId=message.authorId>
  // Always passed, with the condition inside: an @text under an <if> is built
  // at runtime, which makes Marko ship the edit form's renderer to the browser.
  <@text>
    <if=input.editing>
      <form id=editFormId method="post" action=action>
        <input type="hidden" name="returnUrl" value=input.returnUrl>
        <if=error>
          <p class="error" role="alert">${error.message}</p>
        </if>
        <label>
          <if=error?.fields?.text>
            <p class="error" role="alert">${error.fields.text}</p>
          </if>
          <textarea
            name="text"
            placeholder="Type a message"
            required
            rows="3"
            autocomplete="off"
            value=message.text
          />
        </label>
      </form>
    </if>
    <else>
      <span>${message.text}</span>
    </else>
  </@text>
  <if=input.editing>
    <button type="submit" form=editFormId name="command" value="edit">
      Save
    </button>
    <a href=input.returnUrl>Cancel</a>
  </if>
  <else>
    <a href=input.editHref>Edit</a>
    <form method="post" action=action>
      <input type="hidden" name="returnUrl" value=input.returnUrl>
      <button type="submit" name="command" value="delete">Delete</button>
    </form>
  </else>
</app-message>
