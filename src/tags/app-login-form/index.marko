import styles from "./style.module.css";

<const/error=$global.session?.get("POST:/")>

<main class=styles.page>
  <ui-logo/>
  <div class=styles.frame>
    <div class=styles.inner>
      <h1 class=styles.heading>Log in</h1>
      // Posts to the current URL, so a `?to=` return URL survives the login.
      <form class=styles.form method="post">
        <ui-text-field
          label="Name"
          name="name"
          hint="2–100 characters"
          error=(error && (error.fields?.name ?? error.message))
          value=error?.values?.name
          required
          minlength=2
          maxlength=100
          autocomplete="username"
          autofocus
        />
        <ui-button class=styles.submit type="submit" variant="primary">
          Log in
        </ui-button>
      </form>
    </div>
  </div>
</main>
