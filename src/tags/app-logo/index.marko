import styles from "./style.module.css";

// The Marko rainbow as four bars, each in the logo's light shade over its dark
// one, split along a V from the top corners down to the middle; then the
// wordmark.
<span class=styles.logo>
  <img class=styles.bars src="./logo.svg" alt="" width="28" height="20">
  // A parent can set --logo-wordmark: none to show just the bars.
  <span class=styles.wordmark>marko chat</span>
</span>
