export interface Input {
  channelSlug: string;
}

<form
  class="composer"
  method="post"
  action=Run.href("/channels/$slug", { params: { slug: input.channelSlug } })
>
  <const/error=$global.session?.get("POST:/channels/$slug")>
  <if=error>
    <p class="error" role="alert">${error.message}</p>
  </if>
  <label>
    <if=error?.fields?.text>
      <p class="error" role="alert">${error.fields.text}</p>
    </if>
    <textarea
      name="text"
      placeholder="Type a message"
      required
      rows="3"
      autocomplete="off"
    />
  </label>
  <button type="submit">Send</button>
</form>
