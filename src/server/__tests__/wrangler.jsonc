// The tests' Worker: just the D1 database, so the local runtime they borrow
// (see database.ts) has nothing in it that only runs in the app's Worker.
{
  "name": "marko-chat-tests",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "marko-chat", "database_id": "tests" },
  ],
}
