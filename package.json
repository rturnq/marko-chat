{
  "name": "marko-chat",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "marko-run dev src/index.ts",
    "build": "marko-run build src/index.ts",
    "preview": "VITE_PREVIEW=1 marko-run preview src/index.ts",
    "deploy": "pnpm build && wrangler deploy",
    "provision": "node scripts/provision.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "typecheck": "tsc --noEmit && mtc",
    "format": "oxfmt && prettier --write \"**/*.marko\"",
    "lint": "oxlint",
    "test": "vitest run",
    "generate:emoji": "node scripts/emoji/generate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@remix-run/cookie": "^0.7.0",
    "@remix-run/fetch-router": "^0.22.1",
    "@remix-run/session": "^0.4.2",
    "@remix-run/session-middleware": "^0.5.0",
    "marko": "^6.3.53"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@marko/run": "^0.11.12",
    "@marko/type-check": "^3.2.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.9",
    "prettier-plugin-marko": "^4.1.3",
    "typescript": "^6.0.3",
    "valibot": "^1.2.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@11.24.0"
}
